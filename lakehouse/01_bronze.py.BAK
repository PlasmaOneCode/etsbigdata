"""
Bronze Layer: Ingest data dari HDFS ke Delta Lake
Script ini membaca data JSON dari HDFS (API & RSS sources) dan menyimpannya ke Bronze layer.
Fallback ke file lokal jika HDFS tidak tersedia.
"""

import os
from pyspark.sql import SparkSession
from pyspark.sql.functions import current_timestamp, lit, col
from delta import configure_spark_with_delta_pip

def init_spark():
    """Inisialisasi SparkSession dengan Delta Lake configuration"""
    print("=" * 80)
    print("BRONZE LAYER: Initializing SparkSession with Delta Lake")
    print("=" * 80)
    
    builder = configure_spark_with_delta_pip(SparkSession.builder) \
        .appName("News Lakehouse - Bronze Layer") \
        .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension") \
        .config("spark.sql.catalog.spark_catalog", 
                "org.apache.spark.sql.delta.catalog.DeltaCatalog") \
            
    spark = builder.getOrCreate()
    print("✓ SparkSession initialized")
    print(f"✓ Spark version: {spark.version}")
    return spark

def read_from_hdfs(spark, path):
    """
    Baca data JSON dari HDFS dengan multiLine=True
    Returns: DataFrame atau None jika gagal
    """
    try:
        print(f"\n→ Reading from HDFS: {path}")
        df = spark.read \
            .option("multiLine", "true") \
            .option("mode", "PERMISSIVE") \
            .json(path)
        print(f"✓ Successfully read from HDFS: {df.count()} records")
        return df
    except Exception as e:
        print(f"✗ Error reading from HDFS: {e}")
        return None

def read_from_local(spark, path):
    """
    Fallback: Baca data JSON dari file lokal
    Returns: DataFrame atau None jika gagal
    """
    try:
        print(f"\n→ Fallback: Reading from local file: {path}")
        if not os.path.exists(path):
            print(f"✗ File not found: {path}")
            return None
        
        df = spark.read \
            .option("multiLine", "true") \
            .option("mode", "PERMISSIVE") \
            .json(path)
        print(f"✓ Successfully read from local: {df.count()} records")
        return df
    except Exception as e:
        print(f"✗ Error reading from local file: {e}")
        return None

def add_metadata(df, source_type):
    """
    Tambahkan kolom metadata ke dataframe
    - _ingested_at: timestamp saat ingest
    - _source: 'api' atau 'rss'
    """
    df = df.withColumn("_ingested_at", current_timestamp()) \
            .withColumn("_source", lit(source_type))
    return df

def ingest_news_api(spark):
    """
    Ingest API news source ke Bronze layer
    """
    print("\n" + "=" * 80)
    print("INGESTING NEWS API")
    print("=" * 80)
    
    hdfs_api_path = "hdfs://namenode:8020/data/news/api/"
    fallback_path = "./news-api_2026-04-27_11-57.json"
    
    # Coba HDFS, jika gagal gunakan fallback
    df_api = read_from_hdfs(spark, hdfs_api_path)
    if df_api is None:
        print("\n⚠ HDFS not available, trying fallback...")
        df_api = read_from_local(spark, fallback_path)
    
    if df_api is None:
        print("✗ Cannot ingest API news: HDFS and local file both failed")
        return None
    
    # Tambahkan metadata
    df_api = add_metadata(df_api, "api")
    
    # Validasi schema
    expected_cols = {"title", "source", "url", "summary", "timestamp"}
    actual_cols = set(df_api.columns) - {"_ingested_at", "_source"}
    
    if expected_cols.issubset(actual_cols):
        print("✓ Schema validation passed")
    else:
        print(f"⚠ Warning: Expected columns {expected_cols}, got {actual_cols}")
    
    # Simpan ke Bronze Layer
    bronze_api_path = "./lakehouse_data/bronze/news_api"
    print(f"\n→ Writing to Bronze: {bronze_api_path}")
    try:
        df_api.write \
            .format("delta") \
            .mode("append") \
            .save(bronze_api_path)
        print(f"✓ Successfully wrote {df_api.count()} records to Bronze")
    except Exception as e:
        print(f"✗ Error writing to Bronze: {e}")
        return None
    
    return df_api

def ingest_news_rss(spark):
    """
    Ingest RSS news sources ke Bronze layer
    """
    print("\n" + "=" * 80)
    print("INGESTING NEWS RSS")
    print("=" * 80)
    
    hdfs_rss_path = "hdfs://namenode:8020/data/news/rss/"
    
    # Coba HDFS saja (RSS biasanya dari producer_rss.py)
    df_rss = read_from_hdfs(spark, hdfs_rss_path)
    
    if df_rss is None:
        print("⚠ RSS data not available in HDFS")
        return None
    
    # Tambahkan metadata
    df_rss = add_metadata(df_rss, "rss")
    
    # Validasi schema
    expected_cols = {"title", "source", "url", "summary", "timestamp"}
    actual_cols = set(df_rss.columns) - {"_ingested_at", "_source"}
    
    if expected_cols.issubset(actual_cols):
        print("✓ Schema validation passed")
    else:
        print(f"⚠ Warning: Expected columns {expected_cols}, got {actual_cols}")
    
    # Simpan ke Bronze Layer
    bronze_rss_path = "./lakehouse_data/bronze/news_rss"
    print(f"\n→ Writing to Bronze: {bronze_rss_path}")
    try:
        df_rss.write \
            .format("delta") \
            .mode("append") \
            .save(bronze_rss_path)
        print(f"✓ Successfully wrote {df_rss.count()} records to Bronze")
    except Exception as e:
        print(f"✗ Error writing to Bronze: {e}")
        return None
    
    return df_rss

def display_summary(df_api, df_rss):
    """
    Tampilkan ringkasan hasil ingestion
    """
    print("\n" + "=" * 80)
    print("INGESTION SUMMARY")
    print("=" * 80)
    
    if df_api is not None:
        print(f"\n📊 API Records Ingested: {df_api.count()}")
        print("\nAPI Schema:")
        df_api.printSchema()
        print("\nSample API data (first 3 rows):")
        df_api.show(3, truncate=False)
    else:
        print("\n⚠ No API data ingested")
    
    if df_rss is not None:
        print(f"\n📊 RSS Records Ingested: {df_rss.count()}")
        print("\nRSS Schema:")
        df_rss.printSchema()
        print("\nSample RSS data (first 3 rows):")
        df_rss.show(3, truncate=False)
    else:
        print("\n⚠ No RSS data ingested")

def main():
    # Initialize Spark
    spark = init_spark()
    
    try:
        # Ingest API & RSS
        df_api = ingest_news_api(spark)
        df_rss = ingest_news_rss(spark)
        
        # Display summary
        if df_api is not None or df_rss is not None:
            display_summary(df_api, df_rss)
            print("\n" + "=" * 80)
            print("✓ BRONZE LAYER INGESTION COMPLETED")
            print("=" * 80)
            print("\nNext step: python lakehouse/02_silver.py")
        else:
            print("\n✗ INGESTION FAILED: No data available")
    
    except Exception as e:
        print(f"\n✗ CRITICAL ERROR: {e}")
        raise
    
    finally:
        spark.stop()
        print("\n✓ SparkSession stopped")

if __name__ == "__main__":
    main()
